# Copy to `.env` (git-ignored) and fill in. Read by the agent service and the eval runner.

# Gemini, the default model: free tier, no credit card. Create a key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Claude (optional, paid): only needed with RELAY_INVESTIGATOR__MODEL=claude-...
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# RELAY_INVESTIGATOR__MODEL=gemini-3.6-flash
# RELAY_INVESTIGATOR__FALLBACKS=["gemini-3.8-flash", "gemini-3.5-flash", "gemini-3.5-flash-lite", "gemini-3.1-flash-lite"]
# RELAY_INVESTIGATOR__EFFORT=medium
# RELAY_BUDGET__TOOL_CALLS=15
# RELAY_BUDGET__COST_USD=2.0
