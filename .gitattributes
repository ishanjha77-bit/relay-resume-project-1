# Everything is LF in the repo and the working tree — shell scripts, YAML and
# Dockerfiles end up inside Linux containers, where CRLF breaks them.
* text=auto eol=lf

# Windows-only launchers keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.jar  binary
*.woff2 binary
