{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relay.dev/contracts/incident-opened.schema.json",
  "title": "incident.opened",
  "description": "Published by platform-api on the Redis stream `relay.incidents` when an incident is created; consumed by agent-service, which starts an investigation. Delivery is at-least-once: consumers deduplicate by incident.id.",
  "type": "object",
  "required": ["event_id", "type", "at", "incident"],
  "additionalProperties": false,
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "type": { "const": "incident.opened" },
    "at": { "type": "string", "format": "date-time" },
    "incident": {
      "type": "object",
      "required": ["id", "number", "title", "opened_at", "namespace", "alerts"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "number": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "opened_at": { "type": "string", "format": "date-time" },
        "namespace": { "type": "string" },
        "alerts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/alert" }
        }
      }
    }
  },
  "$defs": {
    "alert": {
      "type": "object",
      "required": ["name", "state"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "service": { "type": ["string", "null"] },
        "severity": { "type": ["string", "null"] },
        "state": { "type": "string", "enum": ["firing", "resolved"] },
        "since": { "type": ["string", "null"], "format": "date-time" },
        "summary": { "type": ["string", "null"] }
      }
    }
  }
}
